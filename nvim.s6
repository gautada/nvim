#!/bin/sh

set -e

echo "Starting 'neovim' as headless server"
# cd /home/nvim || exit 1
_cmd="/usr/bin/nvim --headless '+Lazy! sync' +qa"
su nvim -c "${_cmd}"
_cmd="/usr/bin/nvim --headless --listen 0.0.0.0:6074"
su nvim -c "cd /home/nvim || exit 1 ; ${_cmd}"
# exec s6-setuidgid nvim nvim --headless --listen 0.0.0.0:6074

